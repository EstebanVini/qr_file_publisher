<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_qr_file_publisher" model="ir.module.category">
        <field name="name">Creador de Códigos QR</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_qr_code_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_qr_file_publisher"/>
        <field name="comment">Can create and publish their own QR publications.</field>
    </record>

    <record id="group_qr_code_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_qr_file_publisher"/>
        <field name="implied_ids" eval="[(4, ref('group_qr_code_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to every QR publication of the company.</field>
    </record>

    <record id="rule_qr_code_company" model="ir.rule">
        <field name="name">QR Code: multi-company</field>
        <field name="model_id" ref="model_qr_code"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="rule_qr_code_own" model="ir.rule">
        <field name="name">QR Code: own publications</field>
        <field name="model_id" ref="model_qr_code"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_qr_code_user'))]"/>
    </record>

    <record id="rule_qr_code_all" model="ir.rule">
        <field name="name">QR Code: all publications</field>
        <field name="model_id" ref="model_qr_code"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_qr_code_manager'))]"/>
    </record>

</odoo>
